  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Flowe"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Flowe"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Shown by iOS when Flowe first asks for location. Must cover BOTH uses: on-device distance for students, and the public teaching location for instructors.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Flowe موقعك لعرض المدربين القريبين منك. وإذا كنت تُدرّس عبر Flowe، فإن موقع الاستوديو الذي تحدده يصبح جزءًا من ملفك العام حتى يتمكن الطلاب من العثور عليك وحجز حصصك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flowe uses your location to show you instructors nearby. If you teach on Flowe, the studio location you set becomes part of your public profile so students can find and book you."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Flowe משתמש במיקום שלך כדי להציג לך מדריכים קרובים אליך. אם את/ה מלמד/ת ב‑Flowe, מיקום הסטודיו שתגדיר/י הופך לחלק מהפרופיל הציבורי שלך כדי שמתאמנים יוכלו למצוא אותך ולהזמין שיעור."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Shown by iOS when Flowe first asks for photo library access.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Flowe مكتبة صورك حتى تتمكن من مشاركة الصور في المنشورات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flowe uses your photo library so you can share images in posts."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Flowe משתמש בספריית התמונות שלך כדי שתוכל/י לשתף תמונות בפוסטים."
          }
        }
      }
    }
  },
  "version": "1.0"
}
