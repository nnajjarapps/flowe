    "Location access is off. Type your studio address above instead, or turn it on in Settings." : {
      "comment" : "A message that appears when location access is off.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الموقع مغلق. اكتب عنوان استوديوك أعلاه بدلًا من ذلك، أو فعّله في الإعدادات."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה למיקום כבויה. הקלידו את כתובת הסטודיו למעלה, או הפעילו אותה בהגדרות."
          }
        }
      }
    },
    "Location access is off. Your city above still works — turn it on in Settings to add an area." : {
      "comment" : "A note shown to the instructor when location permission was denied.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الموقع مُعطَّل. لا تزال مدينتك أعلاه تعمل — فعِّله من الإعدادات لإضافة منطقة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está desactivado. Tu ciudad de arriba sigue funcionando: actívalo en Ajustes para añadir una zona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la position est désactivé. Votre ville ci-dessus fonctionne toujours — activez-le dans Réglages pour ajouter une zone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה למיקום כבויה. העיר שלך למעלה עדיין פועלת — הפעל אותה בהגדרות כדי להוסיף אזור."
          }
        }
      }
    },
    "Location off — sorted by rating. Search by address instead." : {
      "comment" : "A message displayed when the user has denied location access.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
