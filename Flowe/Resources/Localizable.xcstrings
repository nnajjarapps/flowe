    "Add your photo, studio location, a short bio, your certification and specialties — this is what students see first." : {
      "comment" : "A description of the profile step, for the \"Your profile\" step.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف صورتك وموقع الاستوديو ونبذة قصيرة وشهادتك وتخصصاتك — هذا ما يراه الطلاب أولًا."
          }
        },
        "he" : {
