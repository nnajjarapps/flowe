      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد سياسة إلغاء لأنواع دروسك، وستظهر هنا حالات عدم الحضور والإلغاء المتأخر لحماية دخلك."
