      }
    },
    "FLOWE" : {
      "comment" : "The name of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FLOWE"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FLOWE"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FLOWE"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FLOWE"
          }
        }
      }
    },
    "Flowe counts registrations, and two people can take the last spot at the same moment. If that happens, the later one is told and their spot is released." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب Flowe التسجيلات، وقد يأخذ شخصان المكان الأخير في اللحظة نفسها. إذا حدث ذلك، يُبلَّغ الأخير ويُحرَّر مكانه."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe cuenta las inscripciones, y dos personas pueden ocupar la última plaza a la vez. Si pasa, se avisa a la última y su plaza se libera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe compte les inscriptions, et deux personnes peuvent prendre la dernière place au même instant. Si cela arrive, la dernière est prévenue et sa place est libérée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe סופר הרשמות, ושני אנשים יכולים לתפוס את המקום האחרון באותו רגע. אם זה קורה, המאוחר מביניהם מקבל הודעה ומקומו משוחרר."
          }
        }
      }
    },
    "Flowe doesn't collect session fees — students pay you directly, so they need to know how." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحصّل Flowe رسوم الجلسات — يدفع لك الطلاب مباشرةً، لذا يحتاجون إلى معرفة الطريقة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe no cobra las tarifas de las sesiones: los alumnos te pagan directamente, así que necesitan saber cómo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe ne perçoit pas les frais de séance : les élèves vous paient directement, ils doivent donc savoir comment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe לא גובה תשלום עבור שיעורים — המתאמנים משלמים לך ישירות, אז הם צריכים לדעת איך."
          }
        }
      }
    },
    "Flowe doesn't process payments — you pay %@ directly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تعالج Flowe المدفوعات — تدفع إلى %@ مباشرةً."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe no procesa pagos: le pagas a %@ directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe ne traite pas les paiements — vous payez %@ directement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe לא מעבדת תשלומים — אתה משלם ל-%@ ישירות."
          }
        }
      }
    },
    "Flowe doesn't process session payments — they're settled directly between student and instructor — so there are no payment alerts to send." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعالج Flowe مدفوعات الجلسات — إذ تُسوّى مباشرة بين الطالب والمدرّب — لذلك لا توجد تنبيهات دفع لإرسالها."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe no procesa los pagos de las sesiones (se liquidan directamente entre alumno e instructor), así que no hay avisos de pago que enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe ne traite pas les paiements des séances : ils se règlent directement entre l'élève et l'instructeur, il n'y a donc aucune alerte de paiement à envoyer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe לא מטפל בתשלומים על השיעורים — הם מוסדרים ישירות בין המתאמן למדריך — ולכן אין התראות תשלום לשלוח."
          }
        }
      }
    },
    "Flowe doesn't verify certifications." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتحقق Flowe من الشهادات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe no verifica las certificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe ne vérifie pas les certifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe אינה מאמתת תעודות."
          }
        }
      }
    },
    "Flowe finance statement (%@)" : {
      "comment" : "A share sheet that lets the user download a CSV file of their Flowe finance statement. The argument is the period of the statement.",
      "isCommentAutoGenerated" : true
    },
    "Flowe needs your permission before it can alert you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Flowe إلى إذنك قبل أن يتمكن من تنبيهك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe necesita tu permiso para poder avisarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe a besoin de votre autorisation pour vous alerter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe זקוק לאישור שלך כדי שיוכל להתריע לך."
          }
        }
      }
    },
    "Flowe never takes payment. %@ confirms once you've paid them directly (cash or Bit) — then your ^[%lld class](inflect: true) are added to your balance." : {
      "comment" : "A \"them\" variable is a placeholder for a name, like \"you\" or \"them\", that's used in a sentence. The argument is the string “” or the string “your instructor”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتقاضى Flowe أي مبلغ أبداً. يؤكّد %@ بعد أن تدفع له مباشرة (نقداً أو عبر Bit) — ثم تُضاف %lld حصة إلى رصيدك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Flowe never takes payment. %1$@ confirms once you've paid them directly (cash or Bit) — then your ^[%2$lld class](inflect: true) are added to your balance."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe לעולם לא גובה תשלום. %@ מאשר/ת ברגע ששילמת ישירות (מזומן או Bit) — ואז %lld השיעורים שלך מתווספים ליתרה."
          }
        }
      }
    },
    "Flowe takes no payment — students pay you directly (cash or Bit), and you approve each purchase." : {
      "comment" : "A description of how a package is paid for.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتقاضى Flowe أي مبلغ — يدفع لك الطلاب مباشرة (نقداً أو عبر Bit)، وأنت توافق على كل عملية شراء."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowe לא גובה תשלום — התלמידים משלמים לך ישירות (מזומן או Bit), ואת/ה מאשר/ת כל רכישה."
          }
        }
      }
    },
    "Flowe takes no payment. Students settle with you directly." : {
