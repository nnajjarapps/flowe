    "I agree to Flowe's Terms of Use, Privacy Policy, and Community Guidelines — including zero tolerance for objectionable content and abusive behaviour." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوافق على شروط الاستخدام وسياسة الخصوصية وإرشادات المجتمع الخاصة بـ Flowe — بما في ذلك عدم التسامح إطلاقًا مع المحتوى المُسيء والسلوك المؤذي."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אני מסכים/ה לתנאי השימוש, למדיניות הפרטיות ולכללי הקהילה של Flowe — כולל אפס סובלנות לתוכן פוגעני ולהתנהגות פוגענית."
          }
        }
      }
    },
