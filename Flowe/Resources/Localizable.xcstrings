    "The instructors you asked will no longer see it. You can request cover again after." : {
      "comment" : "A message that appears when you cancel a cover request.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يراها المدربون الذين طلبت منهم بعد الآن. يمكنك طلب التغطية مجددًا لاحقًا."
