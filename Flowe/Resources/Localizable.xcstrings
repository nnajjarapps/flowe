    "It disappears for everyone who hasn't joined, and the people who joined will see it marked cancelled. This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تختفي لكل من لم ينضم، وسيراها من انضموا مُعلَّمة بأنها مُلغاة. لا يمكن التراجع عن ذلك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desaparece para todos los que no se hayan unido, y quienes se unieron lo verán marcado como cancelado. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disparaît pour tous ceux qui ne se sont pas inscrits, et les personnes inscrites le verront marqué comme annulé. Cette action est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה ייעלם לכל מי שלא הצטרף, ומי שכן הצטרף יראה שזה מסומן כמבוטל. אי אפשר לבטל את הפעולה."
          }
        }
      }
    },
    "It disappears for everyone. This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيختفي عن الجميع. لا يمكن التراجع عن ذلك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desaparece para todos. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disparaît pour tout le monde. C'est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה נעלם לכולם. אי אפשר לבטל את הפעולה."
          }
        }
      }
    },
    "It's removed for everyone. This can't be undone." : {
