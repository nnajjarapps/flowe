    "Add your %@ so students can find you." : {
      "comment" : "A paragraph below the title of the button, describing what the button does.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف %@ ليتمكن الطلاب من العثور عليك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu %@ para que los alumnos te encuentren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez votre %@ pour que les élèves vous trouvent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף את ה-%@ שלך כדי שמתאמנים יוכלו למצוא אותך."
          }
        }
      }
    },
    "Add your area so students nearby can see how far you are. Flowe publishes a point rounded to about 1 km — the neighbourhood, never the address." : {
      "comment" : "An explanation shown before the instructor adds a teaching area.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف منطقتك ليرى الطلاب القريبون مدى بُعدك. ينشر Flowe نقطة مقرَّبة إلى نحو كيلومتر واحد — الحي، وليس العنوان."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu zona para que los estudiantes cercanos vean a qué distancia estás. Flowe publica un punto redondeado a alrededor de 1 km: el barrio, nunca la dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez votre zone pour que les élèves proches voient votre distance. Flowe publie un point arrondi à environ 1 km — le quartier, jamais l’adresse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף את האזור שלך כדי שמתאמנים בקרבתך יראו כמה אתה רחוק. Flowe מפרסמת נקודה מעוגלת לכ-1 ק\"מ — השכונה, לעולם לא הכתובת."
          }
        }
      }
    },
    "Add your certification in Edit Profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف شهادتك في تعديل الملف الشخصي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu certificación en Editar perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez votre certification dans Modifier le profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף את ההסמכה שלך בעריכת פרופיל."
