    "Your spot goes back to the pool and someone else can take it. You can rejoin if it's still open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعود مكانك إلى المتاح ويمكن لشخص آخر أخذه. يمكنك الانضمام مجددًا إن كانت الفعالية ما زالت مفتوحة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plaza vuelve a estar disponible y otra persona puede ocuparla. Puedes volver a unirte si sigue abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta place est remise en jeu et quelqu'un d'autre peut la prendre. Tu peux te réinscrire si c'est encore ouvert."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המקום שלך חוזר למאגר ומישהו אחר יכול לקחת אותו. תוכל להצטרף שוב אם הוא עדיין פנוי."
          }
        }
      }
